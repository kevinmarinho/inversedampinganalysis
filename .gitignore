# raw data are kept OUT of git (size ~2 GB); integrity is tracked by data/raw/MANIFEST.sha256
data/raw/**/*
!data/raw/README.md
!data/raw/MANIFEST.sha256
data/processed/*
!data/processed/.gitkeep
results/*
!results/.gitkeep
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# dados externos: binários fora do git (como data/raw); versiona README e manifesto
data/external/**/*
!data/external/**/
!data/external/**/README.md
!data/external/**/MANIFEST.sha256
!data/external/**/*.png
!data/external/**/*.pdf
